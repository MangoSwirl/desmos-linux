# BusyBox 1.37.0 applets that replace GNU coreutils, applied over `make allnoconfig`.
# Static, glibc, no shell (bash stays /bin/sh). Same programs as the old coreutils build, less
# b2sum, sha224sum and sha384sum, which BusyBox doesn't have.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_BUSYBOX=y
# CONFIG_SH_IS_ASH is not set
CONFIG_SH_IS_NONE=y
CONFIG_BASH_IS_NONE=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_DF=y
CONFIG_BASE64=y
CONFIG_BASENAME=y
CONFIG_CAT=y
CONFIG_CHGRP=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CKSUM=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_DATE=y
CONFIG_DD=y
CONFIG_DIRNAME=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_EXPR=y
CONFIG_FALSE=y
CONFIG_FOLD=y
CONFIG_GROUPS=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MD5SUM=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_NPROC=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SEQ=y
CONFIG_SHA1SUM=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_SUM=y
CONFIG_TAIL=y
CONFIG_TEE=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TEST2=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_TRUE=y
CONFIG_TTY=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_UNLINK=y
CONFIG_WC=y
CONFIG_WHOAMI=y
CONFIG_YES=y
CONFIG_FEATURE_TOUCH_SUSV3=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_FEATURE_DD_IBS_OBS=y
CONFIG_FEATURE_DD_STATUS=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_FEATURE_CATN=y
CONFIG_FEATURE_CATV=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y
CONFIG_FEATURE_TEST_64=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_FEATURE_DATE_ISOFMT=y
CONFIG_FEATURE_DATE_NANO=y
CONFIG_FEATURE_DATE_COMPAT=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_DF_FANCY=y
CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_FEATURE_READLINK_FOLLOW=y
CONFIG_FEATURE_TR_CLASSES=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_FEATURE_CHOWN_LONG_OPTIONS=y
CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K=y
CONFIG_UNAME_OSNAME="GNU/Linux"
