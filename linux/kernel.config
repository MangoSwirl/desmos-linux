# Applied on top of `make tinyconfig` (see linux/build-kernel.sh)
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_32BIT=y
CONFIG_MMU=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_EFI is not set
# CONFIG_FPU is not set
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZFA is not set
# CONFIG_RISCV_ISA_ZFH is not set
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CMDLINE="console=hvc0"
CONFIG_CMDLINE_FORCE=y
# Not needed on a machine whose only device is the SBI console
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_COMMON_CLK is not set
CONFIG_LOG_BUF_SHIFT=12
