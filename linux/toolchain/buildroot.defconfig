# Buildroot 2026.05.3 toolchain-only config: rv32ima / ilp32, glibc, GCC 14.4, binutils 2.45.
# Exported with `make savedefconfig`; the glibc/GCC/headers lines are the defaults, kept explicit.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_32=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_7_0=y
BR2_GCC_VERSION_14_X=y
BR2_BINUTILS_VERSION_2_45_X=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
